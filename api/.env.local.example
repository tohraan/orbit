# The data service's environment. Copy to .env.local for local runs.
#
# SUPABASE_SERVICE_KEY bypasses row-level security and belongs ONLY to this
# project. The frontend deployment does not need it and must not have it.
# Never give either of these a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=

# Browser origins permitted to read this API. Comma-separated, no trailing
# slash, exact scheme and host. In development, localhost:3100 is added
# automatically; in production this list is the whole allowlist.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional: absolute path to the fallback snapshot. Defaults to ./data/opportunities.json.
# OPPORTUNITIES_SNAPSHOT=/var/task/data/opportunities.json
