    {
      "name": "Portal Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        -400
      ],
      "parameters": {
        "jsCode": "/* W12 · flatten v_portal_feed into the Google Sheet the existing portal reads.\n * Arrays become pipe-delimited so the sheet stays human-scannable and the\n * portal's existing string parsing keeps working. */\nconst join = a => (Array.isArray(a) ? a : []).filter(Boolean).join(' | ');\nreturn $input.all().map(({ json: o }) => ({ json: {\n  id: o.id,\n  title: o.title,\n  organisation: o.organisation || '',\n  type: o.type,\n  degree_levels: join(o.degree_levels),\n  fields_of_study: join(o.fields_of_study),\n  host_country: o.host_country || '',\n  host_region: o.host_region || '',\n  is_remote: o.is_remote ? 'yes' : 'no',\n  funding: o.funding,\n  funding_detail: o.funding_detail || '',\n  deadline: o.deadline || '',\n  deadline_kind: o.deadline_kind,\n  deadline_note: o.deadline_note || '',\n  days_left: o.days_left === null || o.days_left === undefined ? '' : o.days_left,\n  duration: o.duration_text || '',\n  summary: o.summary || '',\n  eligibility: String(o.eligibility || '').slice(0, 20000),\n  benefits: String(o.benefits || '').slice(0, 20000),\n  how_to_apply: String(o.how_to_apply || '').slice(0, 20000),\n  documents: String(o.documents || '').slice(0, 5000),\n  apply_link: o.apply_link || '',\n  image_url: o.image_url || '',\n  status: o.status,\n  confidence: o.confidence,\n  sources: join(o.sources),\n  source_url: o.canonical_url || '',\n  last_verified_at: o.last_verified_at || '',\n  synced_at: new Date().toISOString(),\n}}));\n"
      }
    },
