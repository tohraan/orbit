      "typeVersion": 4.5,
      "position": [
        -160,
        -400
      ],
      "parameters": {
        "method": "GET",
        "url": "https://pcctpzvhakdutzzwpmsh.supabase.co/rest/v1/v_portal_feed?select=*&order=deadline.asc.nullslast&limit=2000",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true,
              "maxRedirects": 5
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "FluPv7K0v8r1zzx8",
          "name": "Header Auth account"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2500
