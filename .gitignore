.env
.env.local
node_modules/
*.local.json
tests/fixtures/*.html
.DS_Store
.local/
__pycache__/
*.pyc
supabase/.temp/
ui/opportunities.json

# Real CVs used while developing the Dossier extractor. The committed fixture
# (tests/fixtures/dossier/real-cv.pdf) is a redacted copy with the same layout;
# the originals carry a real phone number and email and must not be committed.
tests/fixtures/dossier/*.original.pdf
.vercel

# Appended by `vercel env pull`, and kept: it is broader than the explicit
# .env / .env.local above, so a .env.production or .env.audit cannot be
# committed by accident either. The root .env holds the Supabase SERVICE key.
.env*
