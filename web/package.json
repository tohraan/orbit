{
  "name": "research-opportunity-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "npm run sync:pdfworker && next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit",
    "sync-data": "node scripts/sync-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "sync:pdfworker": "node -e \"const{copyFileSync}=require('fs');copyFileSync(require.resolve('pdfjs-dist/build/pdf.worker.min.mjs'),'public/pdf.worker.min.mjs')\""
  },
  "dependencies": {
    "@rof/core": "0.1.0",
    "@rof/server": "0.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@rof/styles": "*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3"
  }
}
